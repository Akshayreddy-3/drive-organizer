# Copy this file to `.env` and fill in the values.
# Do NOT commit real secrets. The repository .gitignore excludes .env.

# Paths (optional) - default values point to files in project root
CREDENTIALS_FILE=./credentials.json
TOKEN_FILE=./token.json

# Scopes (comma-separated) - default is full Drive access
SCOPES=https://www.googleapis.com/auth/drive

# Verbose logging: True or False
VERBOSE_MODE=True

# Optional: use this OAuth client for Google sign-in instead of the one in
# credentials.json. Leave these commented out unless you have real values —
# whatever is set here is used for sign-in, so a placeholder makes it fail.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# Optionally override the auth/token endpoints
# GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# AI PDF Renamer (ai_pdf_renamer.py) — only needed for --gemini-fallback.
# Use a key from a billing-enabled project: free-tier content may be used to
# train Google's models and read by human reviewers.
# Get your key from: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# AI PDF Renamer — where the sender model runs. Leave unset to use Ollama on this computer.
# To use your own cloud server instead (see SERVER_SETUP.md):
# OLLAMA_URL=http://100.x.y.z:11434

# Company Data Encryption (secure_companies.py)
# Generated automatically when you save a company list in the app, or run:
# python3 secure_companies.py encrypt   — never type one in by hand.
# COMPANIES_KEY=your-encryption-key-here

# Destination Drive folder ID and scan folder — normally set from the app (Settings page)
# BASE_FOLDER_ID=
# SCAN_FOLDER=
