# Copy this file to `.env` and fill in the values.
# Do NOT commit real secrets. The repository .gitignore excludes .env.

# Paths (optional) - default values point to files in project root
CREDENTIALS_FILE=./credentials.json
TOKEN_FILE=./token.json

# Scopes (comma-separated) - default is full Drive access
SCOPES=https://www.googleapis.com/auth/drive

# Verbose logging: True or False
VERBOSE_MODE=True

# Instead of using a credentials.json file you can set your OAuth client
# credentials directly in the .env (optional). If set, the app will use
# these values and skip requiring credentials.json.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optionally override the auth/token endpoints
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# AI PDF Renamer (ai_pdf_renamer.py)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Company Data Encryption (secure_companies.py)
# Generated automatically when you run: python3 secure_companies.py encrypt
COMPANIES_KEY=your-encryption-key-here
